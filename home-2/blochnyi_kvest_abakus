<!doctype html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Блочный квест — формулы абакуса</title><style>
:root{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#20263b;background:#f4f6fc}*{box-sizing:border-box}body{margin:0;padding:24px 12px}.app{max-width:760px;margin:auto}.panel{background:#fff;border-radius:22px;padding:25px;box-shadow:0 12px 35px #24315a12;margin-bottom:14px}h1{margin:4px 0 10px;font-size:clamp(25px,5vw,38px)}h2{font-size:23px;margin:10px 0 20px}.muted{color:#65708c}.pill{display:inline-block;background:#eaf0ff;color:#3455a4;padding:6px 11px;border-radius:99px;font-size:13px;font-weight:700}button,input,select{font:inherit}button{cursor:pointer;border:0;border-radius:13px;padding:13px 17px;font-weight:650}button.primary{background:#425bdb;color:white}button.secondary{background:#eef1fb;color:#263457}button:disabled{opacity:.4;cursor:not-allowed}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.field{display:grid;gap:6px;flex:1;min-width:175px}.field input,.field select,.answer{border:1.5px solid #dce2ef;border-radius:12px;padding:12px;background:white;width:100%;font-size:17px}.choices{display:grid;gap:10px}.choice{background:#f6f8fd;text-align:left;border:2px solid transparent;color:#24314e}.choice.selected{border-color:#425bdb;background:#edf0ff}.choice:disabled{opacity:1;cursor:default}.choice.correct{border-color:#239b77;background:#e6f8f0}.choice.wrong{border-color:#d95461;background:#fff0f1}.problem{font-size:clamp(40px,9vw,68px);font-weight:800;text-align:center;padding:18px 0}.progress{height:9px;background:#e8ecf6;border-radius:99px;overflow:hidden;margin:14px 0}.progress>div{height:100%;background:#425bdb;transition:width .2s}.feedback{border-radius:13px;background:#f2f5ff;padding:13px 16px;margin-top:14px}.hidden{display:none!important}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:#f4f6fc;border-radius:13px;padding:13px;text-align:center}.stat b{font-size:25px;display:block}.small{font-size:13px}.footer{font-size:13px;color:#68748c;text-align:center;padding:6px}table{width:100%;border-collapse:collapse}td,th{padding:9px;border-bottom:1px solid #e6eaf3;text-align:left;font-size:14px}details{margin-top:16px}.print{display:none}@media print{body{background:white}.no-print{display:none!important}.panel{box-shadow:none;padding:5px}.print{display:block}}

/* Игровой блочный интерфейс: автономно, без внешних ресурсов */
:root{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#f7faff;background:#111a35}
body{background:radial-gradient(circle at 15% 12%,#344e96 0,transparent 32%),radial-gradient(circle at 90% 25%,#234c65 0,transparent 30%),linear-gradient(155deg,#0d1732,#192b55 60%,#0c1931);min-height:100vh}
.app{max-width:800px}.panel{background:#1e3157;border:2px solid #5576a6;box-shadow:0 9px 0 #0a1630,0 25px 45px #0005;border-radius:17px;color:#fff;position:relative;overflow:hidden}
.panel:before{content:'';height:7px;position:absolute;left:0;right:0;top:0;background:repeating-linear-gradient(90deg,#64d9fc 0 40px,#74eea1 40px 80px,#ffd35b 80px 120px,#f29bca 120px 160px)}
h1{font-weight:950;letter-spacing:-1px;text-shadow:3px 4px 0 #0b1836}h2{color:#fff}.muted,.small.muted{color:#c7d6f2}.pill{background:#284e7b;color:#aaf2ff;border:1px solid #5494bf;text-transform:uppercase;letter-spacing:.7px}
button{border-radius:10px;box-shadow:0 4px 0 #101c36;transition:transform .12s,filter .12s}button:not(:disabled):active{transform:translateY(3px);box-shadow:0 1px 0 #101c36}
button.primary{background:#7ce16d;color:#15331f;font-weight:900;border:2px solid #bcff9f;box-shadow:0 5px 0 #3e863b}
button.secondary{background:#36527b;color:#fff;border:1px solid #7495c4}
.choice{background:#2a426b;color:#f7faff;border:2px solid #5774a1;padding:16px;text-align:left;font-weight:800}
.choice:hover{filter:brightness(1.16)}.choice.selected{background:#3c5d89;border-color:#85f6a4;box-shadow:inset 5px 0 #85f6a4}
.field input,.field select,.answer{background:#f6fbff;color:#182848;border:2px solid #a8c6f1}
.problem{background:linear-gradient(120deg,#304c7b,#1c3863);border:3px dashed #78d5f8;border-radius:15px;color:#ffe77e;text-shadow:3px 4px 0 #17243b;margin:15px 0}
.progress{background:#102244;border:1px solid #6486b4;height:14px}.progress>div{background:repeating-linear-gradient(90deg,#79e59c 0 18px,#5ac77d 18px 36px)}
.stat{background:#2b4772;border:1px solid #5279ad;color:#fff}.stat b{color:#ffe37b}.footer{color:#c0d4f1}td,th{border-color:#5a759e}details{border:1px solid #526f9b;background:#253d66;padding:10px 12px;border-radius:10px}.feedback{background:#2b4772}
.block-world{display:flex;gap:10px;align-items:end;justify-content:center;padding:20px 6px 10px;margin:4px auto 10px;min-height:140px;background:linear-gradient(#294f8e 0 65%,#447f6a 65% 78%,#294e49 78%);border-radius:13px;border:2px solid #5b91b3;overflow:hidden}
.tower{width:72px;height:85px;background:#e1ad65;border:5px solid #996a42;box-shadow:inset 0 0 0 4px #f2ca87,5px 6px 0 #122744;position:relative}.tower:before{content:'';position:absolute;top:-21px;left:-6px;width:74px;height:20px;background:repeating-linear-gradient(90deg,#f2cb7e 0 14px,#a67848 14px 18px);clip-path:polygon(0 0,20% 0,20% 40%,40% 40%,40% 0,60% 0,60% 40%,80% 40%,80% 0,100% 0,100% 100%,0 100%)}.tower:after{content:'▣';color:#513d43;font-size:40px;position:absolute;top:20px;left:16px}.avatar{width:44px;height:58px;background:linear-gradient(#f7d579 0 28%,#55d9b0 28% 68%,#384fa4 68%);border:4px solid #162d51;box-shadow:5px 5px 0 #122744;position:relative;margin:0 12px}.avatar:before{content:'•  •';position:absolute;top:2px;left:5px;color:#24304b;font-weight:900}.coin{width:36px;height:36px;border:5px solid #f3ad37;background:#ffe27b;box-shadow:4px 4px 0 #142b49;align-self:center;text-align:center;color:#865d19;font-weight:900;font-size:19px}
@media(max-width:450px){.panel{padding:17px}.block-world{min-height:120px}.tower{transform:scale(.82)}.problem{font-size:46px}.stats{gap:5px}.stat{padding:9px}}
</style></head><body><main class="app"><section class="panel" id="start"><span class="pill">Уровень 1 · Блочный мир формул</span><div class="block-world" aria-hidden="true"><div class="tower"></div><div class="avatar"></div><div class="coin">★</div><div class="tower" style="height:105px"></div></div><h1>Блочный квест 🎮</h1><p class="muted">Пройди три испытания: найди путь, выбери формулу и открой следующий уровень правильным ответом!</p><div class="row"><label class="field">Имя ученика<input id="student" maxlength="45" placeholder="Например, Лиза"></label><label class="field">Режим<select id="mode"><option value="quick">На уроке · 5 примеров</option><option value="home">Дома · 12 примеров</option></select></label></div><p class="small muted">Каждый пример — 3 шага: выбор способа → выбор формулы → ответ. Работай на настоящем абакусе. Первая попытка фиксируется, правильные ответы показываются после завершения.</p><button class="primary" id="begin">Играть →</button></section><section class="panel hidden" id="game"><div class="row" style="justify-content:space-between"><span class="pill" id="counter"></span><span class="muted small" id="stepLabel"></span></div><div class="progress"><div id="bar"></div></div><div class="problem" id="problem"></div><h2 id="prompt"></h2><div class="choices" id="choices"></div><div id="entry" class="hidden"><label class="field">Введи ответ после решения на абакусе<input id="numeric" class="answer" type="number" inputmode="numeric" autocomplete="off" min="0" max="99" placeholder="Твой ответ"></label></div><p id="help" class="muted small"></p><div class="row" style="margin-top:18px"><button id="next" class="primary" disabled>Продолжить →</button></div></section><section class="panel hidden" id="result"><span class="pill">Уровень пройден!</span><h1 id="resultTitle"></h1><p class="muted" id="summary"></p><div class="stats"><div class="stat"><b id="s1"></b><span class="small">Способ</span></div><div class="stat"><b id="s2"></b><span class="small">Формула</span></div><div class="stat"><b id="s3"></b><span class="small">Ответ</span></div></div><h2>Разбор примеров</h2><div id="review"></div><p class="small muted">Отчёт сохраняется только на этом устройстве, автоматически педагогу не отправляется.</p><div class="row no-print"><button class="primary" id="download">Скачать отчёт (.txt)</button><button class="secondary" id="copy">Скопировать отчёт</button><button class="secondary" id="restart">Новая тренировка</button></div></section><p class="footer">Работает без интернета · Не требует регистрации · Блочный квест v2.0</p></main><script>
(()=>{'use strict';const $=id=>document.getElementById(id);const labels=['Без формулы','Через пятёрку','Через десятку'];let items=[],at=0,step=0,selected=null,results=[],name='',mode='';
// Проверяем применимость действия к текущему состоянию единичного разряда.
function method(n,k){let low=n%5;if(low+k<=4)return 0;if(n+k<=9&&n<5)return 1;if(n+k<=9&&n>=5&&low+k<=4)return 0;if(n+k<=9)return 1;return 2}
// Базовые варианты +1..+4; для +4 «без формулы» используется 0+4.
const base=[{n:3,k:1,m:0},{n:4,k:1,m:1},{n:9,k:1,m:2},{n:2,k:2,m:0},{n:3,k:2,m:1},{n:8,k:2,m:2},{n:1,k:3,m:0},{n:2,k:3,m:1},{n:7,k:3,m:2},{n:0,k:4,m:0},{n:1,k:4,m:1},{n:6,k:4,m:2}];
function formula(q){if(q.m===0)return '+'+q.k;if(q.m===1)return '+5 − '+(5-q.k);return '−'+(10-q.k)+' + 10'}
function distractors(q){let trueF=formula(q), all=['+'+q.k,'+5 − '+(5-q.k),'−'+(10-q.k)+' + 10'];let extra=['+5 − '+(4-q.k>0?4-q.k:1),'−'+(9-q.k)+' + 10','+5 − '+(6-q.k),'−'+(11-q.k)+' + 10'];let opts=[trueF,...all.filter(x=>x!==trueF),...extra.filter(x=>x!==trueF)];return [...new Set(opts)].slice(0,4).sort(()=>Math.random()-.5)}
function show(id){['start','game','result'].forEach(x=>$(x).classList.toggle('hidden',x!==id))}
function render(){let q=items[at];$('counter').textContent=`Пример ${at+1} из ${items.length}`;$('stepLabel').textContent=`Шаг ${step+1} из 3`;$('bar').style.width=((at*3+step)/(items.length*3)*100)+'%';$('problem').textContent=`${q.n} + ${q.k} = ?`;$('choices').innerHTML='';$('entry').classList.add('hidden');$('next').disabled=true;selected=null;$('next').textContent=step===2?(at===items.length-1?'Завершить':'Следующий пример'):'Продолжить →';if(step===0){$('prompt').textContent='Испытание 1 · Выбери путь';$('help').textContent='Выбери один способ. Подумай, какие бусины свободны.';buttons(labels.map((x,i)=>({label:x,val:i})));}else if(step===1){$('prompt').textContent='Испытание 2 · Найди код формулы';$('help').textContent='Выбери точную запись действий. Если формула не нужна — выбери обычное прибавление.';buttons(distractors(q).map(x=>({label:x,val:x})));}else{$('prompt').textContent='Испытание 3 · Открой портал';$('help').textContent='Передвинь бусины, затем впиши получившееся число.';$('entry').classList.remove('hidden');$('numeric').value='';$('numeric').focus();}}
function buttons(opts){opts.forEach(o=>{let b=document.createElement('button');b.className='choice';b.textContent=o.label;b.onclick=()=>{selected=o.val;document.querySelectorAll('.choice').forEach(c=>c.classList.remove('selected'));b.classList.add('selected');$('next').disabled=false};$('choices').append(b)})}
$('numeric').addEventListener('input',()=>{$('next').disabled=$('numeric').value.trim()===''||!Number.isInteger(Number($('numeric').value))});
$('next').onclick=()=>{let q=items[at],r=results[at];if(step===0){r.method=selected;r.methodOk=selected===q.m}else if(step===1){r.formula=selected;r.formulaOk=selected===formula(q)}else{r.answer=Number($('numeric').value);r.answerOk=r.answer===q.n+q.k}if(step<2){step++;render()}else if(at<items.length-1){at++;step=0;render()}else finish()};
$('begin').onclick=()=>{name=$('student').value.trim()||'Ученик';mode=$('mode').value;items=mode==='quick'?[...base].sort(()=>Math.random()-.5).slice(0,5):[...base].sort(()=>Math.random()-.5);results=items.map(()=>({}));at=0;step=0;show('game');render()};
function report(){let now=new Date().toLocaleString('ru-RU');let lines=[`БЛОЧНЫЙ КВЕСТ — ОТЧЁТ`,`Ученик: ${name}`,`Дата: ${now}`,`Режим: ${mode==='quick'?'5 примеров':'12 примеров'}`,''];let sums=['methodOk','formulaOk','answerOk'].map(k=>results.filter(r=>r[k]).length);lines.push(`Способ: ${sums[0]}/${items.length}; Формула: ${sums[1]}/${items.length}; Ответ: ${sums[2]}/${items.length}`,'');items.forEach((q,i)=>{let r=results[i];lines.push(`${i+1}. ${q.n} + ${q.k} = ${q.n+q.k}; верный способ: ${labels[q.m]}; действия: ${formula(q)}`,`  Выбор способа: ${labels[r.method]} ${r.methodOk?'✓':'✗'}; формула: ${r.formula} ${r.formulaOk?'✓':'✗'}; ответ: ${r.answer} ${r.answerOk?'✓':'✗'}`)});return lines.join('\n')}
function finish(){show('result');$('bar').style.width='100%';$('resultTitle').textContent=`${name}, готово!`;$('summary').textContent=`Выполнено ${items.length} примеров. Посмотри, какие шаги получились, а что стоит повторить.`;['methodOk','formulaOk','answerOk'].forEach((k,i)=>$('s'+(i+1)).textContent=results.filter(r=>r[k]).length+'/'+items.length);$('review').innerHTML='';items.forEach((q,i)=>{let r=results[i],d=document.createElement('details'),s=document.createElement('summary');s.textContent=`${i+1}. ${q.n} + ${q.k} — ${[r.methodOk,r.formulaOk,r.answerOk].filter(Boolean).length}/3 шага`;d.append(s);let p=document.createElement('p');p.className='small';p.textContent=`Верно: ${labels[q.m]}, ${formula(q)}, ответ ${q.n+q.k}. Твой выбор: ${labels[r.method]}, ${r.formula}, ответ ${r.answer}.`;d.append(p);$('review').append(d)})}
$('download').onclick=()=>{let blob=new Blob([report()],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='abakus_'+name.replace(/[^\p{L}\p{N}-]/gu,'_')+'.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
$('copy').onclick=async()=>{let t=report();try{await navigator.clipboard.writeText(t);$('copy').textContent='Скопировано ✓'}catch(e){let el=document.createElement('textarea');el.value=t;document.body.append(el);el.select();document.execCommand('copy');el.remove();$('copy').textContent='Скопировано ✓'}};
$('restart').onclick=()=>show('start');})();
</script></body></html>
